<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Push Notifications Capability -->
    <key>aps-environment</key>
    <string>development</string>

    <!-- Universal Links — shared across every flavor (CODE_SIGN_ENTITLEMENTS
         points every build config at this one file). Which paths each app
         actually handles is scoped per tenant in the hosted
         apple-app-site-association JSON, not here — the domain itself is
         the same for every tenant. -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:ecomadmin.shalviadvision.com</string>
    </array>

    <!-- Background App Refresh -->
    <!-- <key>com.apple.developer.background-modes</key>
    <array>
        <string>background-fetch</string>
        <string>remote-notification</string>
    </array> -->
    
    <!-- Additional capabilities that might be needed -->
    <!-- <key>com.apple.developer.networking.wifi-info</key>
    <true/> -->
    
    <!-- For location services if needed -->
    <!-- <key>com.apple.developer.location.push</key>
    <true/> -->
</dict>
</plist>